---
import BaseLayout from "../layouts/BaseLayout.astro";
import FeaturedPost from "../components/FeaturedPost.astro";

import { getCollection } from 'astro:content';

// Get recent articles
const recentArticles = (await getCollection('articles', ({ data }) => {
  return data.draft !== true;
})).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 3);
---

<BaseLayout
  title="SPHERE — Society for the Progress, Human Rights, Empowerment & Equity"
  description="SPHERE: Bridging human rights advocacy and community action in Sri Lanka. Centre for Digital Policy Research (CDPR), digital rights, trainings, and civic empowerment."
>
  <main class="page page--home page-animate">

    <section id="home" class="home-hero">
      <div class="home-hero__bg">
        <div class="home-hero__blob home-hero__blob--1"></div>
        <div class="home-hero__blob home-hero__blob--2"></div>
        <div class="home-hero__blob home-hero__blob--3"></div>
      </div>
      
      <div class="container" style="position:relative; z-index:2;">
        <div class="home-hero__grid">
          <div class="home-hero__text">
            <span class="home-hero__eyebrow">Society for Progress, Human Rights, Empowerment &amp; Equity</span>
            <h1 class="home-hero__title">
              Bridging <span class="text-gradient">human rights</span> &amp; community action in Sri Lanka
            </h1>
            <p class="home-hero__desc">
              SPHERE sustains the momentum of civic participation — defending civil and political rights,
              advancing digital rights, and empowering communities to shape a just, democratic future.
            </p>
            <div class="home-hero__actions">
                <a href="/about" class="btn btn--primary btn--lg">About Us</a>
            </div>
          </div>
          <div class="home-hero__panel-container">
            {recentArticles.length > 0 && (
              <a href={"/articles/" + recentArticles[0].slug} class="featured-article-glass">
                <div class="featured-article-glass__image-wrapper">
                  <img src={recentArticles[0].data.coverImage} alt={recentArticles[0].data.title} class="featured-article-glass__image" />
                  <div class="featured-article-glass__badge">Official Publication</div>
                </div>
                <div class="featured-article-glass__content">
                  <span class="featured-article-glass__label">Latest Article</span>
                  <h3 class="featured-article-glass__title">{recentArticles[0].data.title}</h3>
                  <p class="featured-article-glass__desc">{recentArticles[0].data.description}</p>
                  <span class="featured-article-glass__link">Read Article &rarr;</span>
                </div>
              </a>
            )}
            {recentArticles.length === 0 && (
              <div class="hero__panel"><strong>Articles coming soon...</strong></div>
            )}
          </div>
        </div>
      </div>
    </section>

    <style>
    /* ── Premium Home Hero ── */
    .home-hero {
      position: relative;
      overflow: hidden;
      background: linear-gradient(135deg, #f0fdf8 0%, #f0f9ff 60%, #fafafa 100%);
      min-height: 90vh;
      display: flex;
      align-items: center;
      padding: 60px 0;
      border-bottom: 1px solid #e2e8f0;
    }
    .home-hero__bg {
      position: absolute;
      inset: 0;
      overflow: hidden;
      z-index: 1;
      background: url('/noise.png'); /* Optional texture */
      opacity: 0.3;
    }
    .home-hero__blob {
      position: absolute;
      border-radius: 50%;
      filter: blur(120px);
      opacity: 0.25;
      animation: float 20s infinite ease-in-out alternate;
    }
    .home-hero__blob--1 {
      width: 600px; height: 600px;
      background: radial-gradient(circle, #99f6e4, transparent 70%);
      top: -10%; right: -10%;
    }
    .home-hero__blob--2 {
      width: 500px; height: 500px;
      background: radial-gradient(circle, #bae6fd, transparent 70%);
      bottom: -20%; left: -10%;
      animation-delay: -5s;
    }
    .home-hero__blob--3 {
      width: 400px; height: 400px;
      background: radial-gradient(circle, #a5b4fc, transparent 70%);
      top: 30%; left: 40%;
      animation-delay: -10s;
      opacity: 0.15;
    }
    
    @keyframes float {
        0% { transform: translate(0, 0) scale(1); }
        50% { transform: translate(50px, 30px) scale(1.1); }
        100% { transform: translate(-30px, 50px) scale(0.9); }
    }

    .home-hero__grid {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 60px;
      align-items: center;
    }
    .home-hero__text {
        position: relative;
        z-index: 10;
    }
    .home-hero__eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 0.75rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: #0d9488;
      background: rgba(13, 148, 136, 0.08);
      border: 1px solid rgba(13, 148, 136, 0.2);
      border-radius: 100px;
      padding: 6px 16px;
      margin-bottom: 24px;
      box-shadow: 0 0 20px rgba(13, 148, 136, 0.1);
    }
    .home-hero__title {
      font-size: clamp(2.5rem, 5vw, 4rem);
      font-weight: 900;
      color: #0f172a;
      line-height: 1.1;
      letter-spacing: -0.03em;
      margin: 0 0 24px;
    }
    .text-gradient {
      background: linear-gradient(135deg, #0d9488 0%, #0284c7 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .home-hero__desc {
      font-size: 1.1rem;
      color: #475569;
      line-height: 1.7;
      margin: 0 0 40px;
      max-width: 540px;
    }
    
    .home-hero__actions {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
    }
    
    .btn--lg {
        padding: 14px 28px;
        font-size: 1.05rem;
    }
    
    /* Glassmorphism Article Card */
    .home-hero__panel-container {
        perspective: 1000px;
    }
    
    .featured-article-glass {
        display: block;
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.9);
        border-radius: 24px;
        overflow: hidden;
        text-decoration: none;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        box-shadow: 0 20px 40px rgba(15, 23, 42, 0.06), inset 0 1px 0 rgba(255,255,255,1);
        transform: translateY(0) rotateX(2deg) rotateY(-5deg);
        transform-origin: center right;
    }
    
    .featured-article-glass:hover {
        transform: translateY(-10px) rotateX(0) rotateY(0);
        background: rgba(255, 255, 255, 0.9);
        border-color: rgba(2, 132, 199, 0.3);
        box-shadow: 0 30px 60px rgba(15, 23, 42, 0.1), 0 0 30px rgba(2, 132, 199, 0.1), inset 0 1px 0 rgba(255,255,255,1);
    }
    
    .featured-article-glass__image-wrapper {
        position: relative;
        height: 240px;
        overflow: hidden;
    }
    
    .featured-article-glass__image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s ease;
    }
    
    .featured-article-glass:hover .featured-article-glass__image {
        transform: scale(1.05);
    }
    
    .featured-article-glass__badge {
        position: absolute;
        top: 16px;
        right: 16px;
        background: rgba(255,255,255,0.9);
        backdrop-filter: blur(8px);
        color: #0f172a;
        padding: 6px 12px;
        border-radius: 100px;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        border: 1px solid rgba(0,0,0,0.05);
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
    }

    .featured-article-glass__content {
        padding: 32px;
    }
    
    .featured-article-glass__label {
        display: block;
        color: #0284c7;
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-bottom: 12px;
    }
    
    .featured-article-glass__title {
        color: #0f172a;
        font-size: 1.5rem;
        font-weight: 800;
        line-height: 1.3;
        margin: 0 0 12px;
    }
    
    .featured-article-glass__desc {
        color: #475569;
        font-size: 0.95rem;
        line-height: 1.6;
        margin: 0 0 24px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    
    .featured-article-glass__link {
        display: inline-flex;
        align-items: center;
        color: #0d9488;
        font-weight: 700;
        font-size: 0.9rem;
        transition: transform 0.2s ease;
    }
    
    .featured-article-glass:hover .featured-article-glass__link {
        transform: translateX(4px);
    }

    /* ── Tablet ── */
    @media (max-width: 992px) {
      .home-hero { padding: 60px 0 40px; min-height: auto; }
      .home-hero__grid { grid-template-columns: 1fr; gap: 36px; }
      .home-hero__title { font-size: 2.4rem; margin-bottom: 16px; }
      .home-hero__desc { font-size: 1rem; margin-bottom: 28px; }
      .featured-article-glass { transform: none; max-width: 500px; }
      .featured-article-glass:hover { transform: translateY(-5px); }
      .featured-article-glass__image-wrapper { height: 180px; }
      .featured-article-glass__content { padding: 24px; }
      .featured-article-glass__title { font-size: 1.2rem; }
    }

    /* ── Mobile ── */
    @media (max-width: 768px) {
      .home-hero { padding: 40px 0 32px; }
      .home-hero__grid { gap: 28px; }
      .home-hero__eyebrow {
        font-size: 0.6rem;
        padding: 5px 12px;
        letter-spacing: 0.08em;
        margin-bottom: 16px;
      }
      .home-hero__title {
        font-size: 1.85rem;
        margin-bottom: 14px;
        line-height: 1.15;
      }
      .home-hero__desc {
        font-size: 0.9rem;
        line-height: 1.6;
        margin-bottom: 24px;
      }
      .home-hero__actions { gap: 12px; }
      .btn--lg { padding: 12px 22px; font-size: 0.95rem; }
      .featured-article-glass { max-width: 100%; }
      .featured-article-glass__image-wrapper { height: 160px; }
      .featured-article-glass__content { padding: 20px; }
      .featured-article-glass__title { font-size: 1.1rem; margin-bottom: 8px; }
      .featured-article-glass__desc { font-size: 0.85rem; margin-bottom: 16px; }
      .featured-article-glass__label { font-size: 0.7rem; margin-bottom: 8px; }
      .featured-article-glass__badge { font-size: 0.6rem; padding: 4px 10px; }
      /* CDPR Section Mobile */
      .home-hero__grid--cdpr { grid-template-columns: 1fr !important; gap: 24px; }
      .about-hero__image-wrap { order: -1; }
      .about-hero__image { min-height: 220px !important; }
    }

    /* ── Small Phone ── */
    @media (max-width: 480px) {
      .home-hero { padding: 28px 0 24px; }
      .home-hero__grid { gap: 20px; }
      .home-hero__eyebrow {
        font-size: 0.52rem;
        padding: 4px 10px;
        letter-spacing: 0.06em;
        margin-bottom: 12px;
      }
      .home-hero__title {
        font-size: 1.5rem;
        margin-bottom: 12px;
      }
      .home-hero__desc {
        font-size: 0.85rem;
        margin-bottom: 20px;
      }
      .btn--lg { padding: 11px 20px; font-size: 0.88rem; }
      .featured-article-glass__image-wrapper { height: 140px; }
      .featured-article-glass__content { padding: 16px; }
      .featured-article-glass__title { font-size: 1rem; }
      .featured-article-glass__desc { font-size: 0.8rem; -webkit-line-clamp: 2; }
      .about-hero__image { min-height: 180px !important; }
    }
    </style>

    <style>
    /* ── Bento Grid Mission ── */
    .bento-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
      margin-top: 24px;
    }
    
    .bento-card {
      background: white;
      border-radius: 24px;
      padding: 40px;
      transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      border: 1px solid rgba(0,0,0,0.05);
      box-shadow: 0 10px 30px rgba(0,0,0,0.03);
    }
    
    .bento-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.08);
    }
    
    .bento-card--wide {
      grid-column: span 2;
      flex-direction: row;
      align-items: center;
      gap: 32px;
    }
    
    .bento-card::before {
        content: '';
        position: absolute;
        inset: 0;
        opacity: 0.1;
        background-size: 200% 200%;
        animation: bgShift 15s ease infinite alternate;
        z-index: 0;
    }
    
    @keyframes bgShift {
        0% { background-position: 0% 50%; }
        100% { background-position: 100% 50%; }
    }
    
    .bento-card--blue::before { background-image: linear-gradient(135deg, #0284c7, #38bdf8, transparent); }
    .bento-card--emerald::before { background-image: linear-gradient(135deg, #059669, #34d399, transparent); }
    .bento-card--purple::before { background-image: linear-gradient(135deg, #7c3aed, #a78bfa, transparent); }
    
    .bento-card__icon {
      width: 64px;
      height: 64px;
      border-radius: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 24px;
      z-index: 1;
      position: relative;
      background: white;
      box-shadow: 0 8px 16px rgba(0,0,0,0.05);
    }
    
    .bento-card--blue .bento-card__icon { color: #0284c7; }
    .bento-card--emerald .bento-card__icon { color: #059669; }
    .bento-card--purple .bento-card__icon { color: #7c3aed; }
    .bento-card--wide .bento-card__icon { margin-bottom: 0; flex-shrink: 0; width: 80px; height: 80px; border-radius: 24px; }
    
    .bento-card__content { position: relative; z-index: 1; }
    .bento-card h3 {
      font-size: 1.5rem;
      font-weight: 800;
      color: #0f172a;
      margin: 0 0 12px;
      letter-spacing: -0.02em;
    }
    .bento-card p {
      font-size: 1.05rem;
      color: #475569;
      line-height: 1.6;
      margin: 0;
    }
    
    @media (max-width: 768px) {
        .bento-grid { grid-template-columns: 1fr; }
        .bento-card--wide { grid-column: auto; flex-direction: column; align-items: flex-start; gap: 24px; }
        .bento-card { padding: 32px; }
    }
    </style>



    <!-- CDPR Section - Interactive Layout -->
    <section id="cdpr" class="home-hero" style="min-height: auto; padding: 80px 0; background: #ffffff;">
      <div class="home-hero__bg">
        <div class="home-hero__blob home-hero__blob--1" style="background: radial-gradient(circle, #bae6fd, transparent 70%);"></div>
        <div class="home-hero__blob home-hero__blob--2" style="background: radial-gradient(circle, #e0e7ff, transparent 70%);"></div>
      </div>
      
      <div class="container" style="position:relative; z-index:2;">
        <div class="home-hero__grid home-hero__grid--cdpr">
          <div class="home-hero__text">
            <span class="home-hero__eyebrow" style="color: #0284c7; background: rgba(2, 132, 199, 0.08); border-color: rgba(2, 132, 199, 0.2);">Advancing Rights in the Digital Age</span>
            <h2 class="home-hero__title" style="font-size: clamp(2rem, 4vw, 3rem);">
              Centre for <span class="text-gradient" style="background: linear-gradient(135deg, #0284c7 0%, #3b82f6 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Digital Policy</span> Research
            </h2>
            <p class="home-hero__desc" style="max-width: 100%;">
              The Centre for Digital Policy and Rights (CDPR) serves as the specialized arm of SPHERE, dedicated to ensuring that Sri Lanka’s technological evolution strengthens democratic values rather than undermining them. We bridge the gap between complex digital shifts and fundamental human rights through rigorous legal analysis, evidence-based research, and proactive policy advocacy.
            </p>
            <div class="home-hero__actions">
              <a class="btn btn--primary btn--lg" href="/cdpr">Explore CDPR</a>
              <a class="btn btn--outline btn--lg" href="/articles">Read Publications</a>
            </div>
          </div>
          <div class="about-hero__image-wrap">
             <div class="about-hero__image-frame" style="border-radius: 24px; overflow: hidden; border: 1px solid #e2e8f0; box-shadow: 0 24px 48px rgba(15,23,42,0.1);">
               <img src="/cdpr-campaign.jpg" alt="CDPR Presentation" class="about-hero__image" style="width: 100%; height: 100%; min-height: 400px; object-fit: cover; display: block;" />
             </div>
          </div>
        </div>
      </div>
    </section>






    <!-- Photo Gallery — Our Work in Action -->
    <section class="section" style="background: #f8fafc; padding-top: 80px; padding-bottom: 80px;"> 
      <div class="container"> 
        <h2 class="section__title" style="text-align: center; margin-bottom: 12px;">Our Work in Action</h2>
        <p style="text-align: center; margin-bottom: 48px; max-width: 600px; margin-left: auto; margin-right: auto; font-size: 1.05rem; color: #475569; line-height: 1.6;">Driving systemic reform and building capacity for human rights defenders across Sri Lanka.</p> 
        
        <div class="cdpr-bento-gallery"> 
          <div class="cdpr-bento__item cdpr-bento__item--featured"> 
            <img src="/cdpr-group.jpg" alt="CDPR group photo with SPHERE banner" loading="lazy"> 
          </div> 
          <div class="cdpr-bento__item cdpr-bento__item--tall"> 
            <img src="/cdpr-event-1.jpg" alt="CDPR presenter at advocacy programme" loading="lazy"> 
          </div> 
          <div class="cdpr-bento__item"> 
            <img src="/cdpr-event-2.jpg" alt="CDPR audience at advocacy programme" loading="lazy"> 
          </div> 
          <div class="cdpr-bento__item"> 
            <img src="/cdpr-event-3.jpg" alt="CDPR participants engaged at workshop" loading="lazy"> 
          </div> 
        </div> 
        
      </div> 
      
      <style>
      .cdpr-bento-gallery {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        grid-template-rows: repeat(2, 260px);
        gap: 16px;
        border-radius: 20px;
      }
      .cdpr-bento__item {
        position: relative;
        overflow: hidden;
        border-radius: 16px;
        box-shadow: 0 4px 12px rgba(15,23,42,0.06);
        background: #e2e8f0;
      }
      .cdpr-bento__item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .cdpr-bento__item:hover img {
        transform: scale(1.06);
      }
      .cdpr-bento__item--featured {
        grid-column: span 2;
        grid-row: span 2;
      }
      .cdpr-bento__item--tall {
        grid-column: span 1;
        grid-row: span 2;
      }

      @media (max-width: 900px) {
        .cdpr-bento-gallery {
          grid-template-columns: repeat(2, 1fr);
          grid-template-rows: auto;
        }
        .cdpr-bento__item--featured {
          grid-column: span 2;
          grid-row: span 1;
          height: 340px;
        }
        .cdpr-bento__item--tall {
          grid-column: span 1;
          grid-row: span 1;
          height: 240px;
        }
        .cdpr-bento__item:not(.cdpr-bento__item--featured):not(.cdpr-bento__item--tall) {
          height: 240px;
        }
      }

      @media (max-width: 600px) {
        .cdpr-bento-gallery {
          grid-template-columns: 1fr;
        }
        .cdpr-bento__item {
          grid-column: 1 / -1 !important;
          grid-row: auto !important;
          height: 260px !important;
        }
      }
      </style>
    </section>

    <!-- YouTube Video Bar -->
    <section class="video-section" style="background: linear-gradient(135deg, #f0fdf8 0%, #f0f9ff 60%, #fafafa 100%); padding: 20px 0 !important; border-top: 1px solid #e2e8f0;">
      <div class="container">
        <div style="text-align: center; margin-bottom: 16px;">
          <h2 class="section__title" style="color: #0f172a; margin: 0 0 10px; font-size: clamp(1.4rem, 3vw, 2rem); font-weight: 900; letter-spacing: -0.02em;">Watch Our Videos</h2>
          <p style="color: #475569; font-size: 0.95rem; max-width: 760px; margin: 0 auto; line-height: 1.65;">Empowering citizens, professionals, and students to navigate the digital landscape — because in today's world, understanding your digital rights isn't just an advantage, it's a necessity.</p>
        </div>

        <div class="video-grid">
          <div class="video-card">
            <div class="video-card__embed">
              <iframe
                src="https://www.youtube-nocookie.com/embed/PivTk5HfEE0"
                title="SPHERE Video 1"
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
              ></iframe>
            </div>
          </div>

          <div class="video-card">
            <div class="video-card__embed">
              <iframe
                src="https://www.youtube-nocookie.com/embed/lZCNWrnRQTo"
                title="SPHERE Video 2"
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
              ></iframe>
            </div>
          </div>

          <div class="video-card">
            <div class="video-card__embed">
              <iframe
                src="https://www.youtube-nocookie.com/embed/ev8iA0ng6cw"
                title="SPHERE Video 3"
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
              ></iframe>
            </div>
          </div>

          <div class="video-card">
            <div class="video-card__embed">
              <iframe
                src="https://www.youtube-nocookie.com/embed/bVozcYyInOY"
                title="SPHERE Video 4"
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
              ></iframe>
            </div>
          </div>
        </div>

        <div style="text-align: center; margin-top: 12px;">
          <a href="https://www.youtube.com/@SLDigitalWatch" target="_blank" rel="noopener noreferrer" class="video-section__cta">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="flex-shrink: 0;"><path d="M21.8 8.0a2.75 2.75 0 0 0-1.9-1.9C18.2 5.7 12 5.7 12 5.7s-6.2 0-7.9.4A2.75 2.75 0 0 0 2.2 8.0 28.4 28.4 0 0 0 1.8 12a28.4 28.4 0 0 0 .4 4 2.75 2.75 0 0 0 1.9 1.9c1.7.4 7.9.4 7.9.4s6.2 0 7.9-.4a2.75 2.75 0 0 0 1.9-1.9 28.4 28.4 0 0 0 .4-4 28.4 28.4 0 0 0-.4-4zM9.7 15.5V8.5l6.5 3.5-6.5 3.5z"/></svg>
            View All on YouTube
          </a>
        </div>
      </div>

      <style>
        .video-section__eyebrow {
          display: inline-flex;
          align-items: center;
          gap: 6px;
          font-size: 0.7rem;
          font-weight: 800;
          text-transform: uppercase;
          letter-spacing: 0.15em;
          color: #0d9488;
          background: rgba(13, 148, 136, 0.08);
          border: 1px solid rgba(13, 148, 136, 0.2);
          border-radius: 100px;
          padding: 5px 14px;
        }
        .video-grid {
          display: grid;
          grid-template-columns: repeat(4, 1fr);
          gap: 20px;
        }
        .video-card {
          background: rgba(255, 255, 255, 0.85);
          backdrop-filter: blur(12px);
          -webkit-backdrop-filter: blur(12px);
          border: 1px solid #e2e8f0;
          border-radius: 20px;
          overflow: hidden;
          box-shadow: 0 4px 16px rgba(15, 23, 42, 0.06), inset 0 1px 0 rgba(255,255,255,0.9);
          transition: all 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        .video-card:hover {
          transform: translateY(-6px);
          border-color: rgba(13, 148, 136, 0.3);
          box-shadow: 0 20px 40px rgba(13, 148, 136, 0.12), 0 0 0 1px rgba(13, 148, 136, 0.15), inset 0 1px 0 rgba(255,255,255,1);
        }
        .video-card__embed {
          position: relative;
          width: 100%;
          padding-bottom: 56.25%;
          height: 0;
          overflow: hidden;
          border-radius: 20px;
        }
        .video-card__embed iframe {
          position: absolute;
          top: 0;
          left: 0;
          width: 100%;
          height: 100%;
          border: none;
          display: block;
        }
        .video-section__cta {
          display: inline-flex;
          align-items: center;
          gap: 8px;
          background: linear-gradient(135deg, #0d9488 0%, #0284c7 100%);
          color: #fff;
          font-weight: 700;
          font-size: 0.95rem;
          padding: 13px 28px;
          border-radius: 100px;
          text-decoration: none;
          transition: all 0.25s ease;
          box-shadow: 0 4px 20px rgba(13, 148, 136, 0.3);
        }
        .video-section__cta:hover {
          transform: translateY(-2px);
          box-shadow: 0 8px 28px rgba(13, 148, 136, 0.4);
          filter: brightness(1.08);
        }
        @media (max-width: 1024px) {
          .video-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
          }
        }
        @media (max-width: 600px) {
          .video-grid {
            grid-template-columns: 1fr;
            max-width: 480px;
            margin: 0 auto;
            gap: 16px;
          }
        }
      </style>
    </section>


    <!-- Latest Insights Carousel -->
    <section class="section" style="background: #fafafa; border-top: 1px solid #f1f5f9; padding: 80px 0;">
      <div class="container">
        <div class="section__header" style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 40px;">
          <div>
            <p class="section__kicker">Latest Insights</p>
            <h2 class="section__title" style="margin: 0;">Recent Articles</h2>
          </div>
          <a href="/articles" class="btn btn--outline">View All</a>
        </div>
        
        <div class="article-carousel">
          {recentArticles.length > 0 ? recentArticles.map((article) => (
            <a href={"/articles/" + article.slug} class="featured-article-glass" style="transform: none; transform-origin: center;">
              <div class="featured-article-glass__image-wrapper" style="height: 200px;">
                <img src={article.data.coverImage} alt={article.data.title} class="featured-article-glass__image" />
              </div>
              <div class="featured-article-glass__content" style="padding: 24px;">
                <h3 class="featured-article-glass__title" style="font-size: 1.25rem; color: #0f172a;">{article.data.title}</h3>
                <p class="featured-article-glass__desc" style="color: #475569; font-size: 0.9rem;">{article.data.description}</p>
                <span class="featured-article-glass__link">Read Article &rarr;</span>
              </div>
            </a>
          )) : (
            <p>No articles found yet.</p>
          )}
        </div>
      </div>
      
      <style>
      .article-carousel {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
      }
      @media (max-width: 992px) {
        .article-carousel {
          grid-template-columns: repeat(2, 1fr);
        }
      }
      @media (max-width: 768px) {
        .article-carousel {
          grid-template-columns: 1fr;
        }
      }
      </style>
    </section>
  </main>
</BaseLayout>

