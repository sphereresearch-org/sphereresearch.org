---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from 'astro:content';
import BlogCard from '../../components/BlogCard.astro';

// Get all published articles
const allPosts = await getCollection('articles', ({ data }) => {
  return data.draft !== true;
});

// Category priority mapping
const categoryPriority: Record<string, number> = {
  cdpr: 1,
  advocacy: 2,
  training: 3,
  general: 4,
};

// Sort by category priority first, then by date (newest first)
const posts = allPosts.sort((a, b) => {
  const priorityA = categoryPriority[a.data.category] || 99;
  const priorityB = categoryPriority[b.data.category] || 99;
  
  if (priorityA !== priorityB) {
    return priorityA - priorityB;
  }
  
  return b.data.date.getTime() - a.data.date.getTime();
});

// Get unique categories
const categories = ['all', ...new Set(posts.map(p => p.data.category))];


---

<BaseLayout title="SPHERE Articles — Official Publications" description="Official reports, event summaries, and research from SPHERE.">
  <main class="page page-animate">
    {posts.length > 0 ? (
      <>
        <!-- Publications Section -->
        <section class="section" style="padding-top: 60px; padding-bottom: 0;">
          <div class="container">
            <div style="margin-bottom: 48px;">
              <h1 class="section__title" style="margin: 0 0 16px;">Publications</h1>
            </div>
            
            <div class="reports-grid">
              <!-- Report 1 -->
              <div class="report-card">
                <div class="report-card__image">
                  <img src="/reports/digital_frontier_cover.jpg" alt="Navigating Sri Lanka’s Digital Frontier" />
                </div>
                <div class="report-card__content">
                  <h3 class="report-card__title">Navigating Sri Lanka’s Digital Frontier</h3>
                  <div class="report-card__desc-wrapper">
                    <p class="report-card__desc">As cyberspace transitions from a technical luxury into our primary arena for daily life, the gap between citizens' vulnerabilities and the state's protective capacity has widened significantly. This comprehensive mapping exercise by digital rights researchers explores the deeply intertwined realities of cybersecurity, online crime, and human rights in Sri Lanka.</p>
                    <div class="report-card__desc-more" style="display: none;">
                      <p class="report-card__desc">Drawing from extensive stakeholder consultations and institutional audits, the report unpacks the critical challenges plaguing our digital ecosystem:</p>
                      <ul class="report-card__list">
                        <li><strong>Legislative Overreach & Ambiguity:</strong> Explores the systemic friction surrounding the Online Safety Act (OSA) and the enforcement paralysis of the Personal Data Protection Act (PDPA).</li>
                        <li><strong>Institutional Bottlenecks:</strong> Documents the severe resource constraints within Sri Lanka CERT and the geographic limitations and cultural hurdles facing victims at the Computer Crime Investigation Division (CCID).</li>
                        <li><strong>Corporate Accountability:</strong> Examines the context-agnostic moderation and linguistic blindspots of global tech monopolies like Meta, TikTok, and YouTube.</li>
                      </ul>
                      <p class="report-card__desc">Moving beyond critique, the publication offers a concrete, rights-respecting roadmap—advocating for empathy-driven school curricula, decentralized law enforcement, and a unified South Asian regional coalition to hold global tech platforms accountable.</p>
                    </div>
                    <button class="btn btn--outline btn--read-more" style="margin-bottom: 24px; padding: 6px 12px; font-size: 14px;">Read More</button>
                  </div>
                  <div style="margin-top: auto;">
                    <a href="/reports/navigating-digital-frontier.pdf" download class="btn btn--primary">Download Full PDF Report</a>
                  </div>
                </div>
              </div>

              <!-- Report 2 -->
              <div class="report-card">
                <div class="report-card__image">
                  <img src="/reports/human_rights_cover.png" alt="Reimagining Human Rights in the Digital Age" />
                </div>
                <div class="report-card__content">
                  <h3 class="report-card__title">Reimagining Human Rights in the Digital Age</h3>
                  <div class="report-card__desc-wrapper">
                    <p class="report-card__desc">As our personal, professional, and civic lives increasingly shift into online spaces, safeguarding fundamental liberties has become more critical than ever. This comprehensive report explores how digital transformation is redefining human rights, from free speech and peaceful assembly to the emerging demands for data protection and informational autonomy.</p>
                    <div class="report-card__desc-more" style="display: none;">
                      <p class="report-card__desc">While Sri Lanka's 1978 Constitution guarantees essential civil liberties, these pre-digital frameworks face unprecedented challenges from algorithmic governance, online surveillance, and arbitrary network shutdowns. Dive into this timely analysis to examine the delicate, complex balance between state-led public security and individual privacy in a hyper-connected society.</p>
                    </div>
                    <button class="btn btn--outline btn--read-more" style="margin-bottom: 24px; padding: 6px 12px; font-size: 14px;">Read More</button>
                  </div>
                  <div style="margin-top: auto;">
                    <a href="/reports/reimagining-human-rights.pdf" download class="btn btn--primary">Download Full PDF Report</a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- All Posts -->
        <section class="section" style="padding-top: 60px;">
          <div class="container">
            <div style="margin-bottom: 48px; max-width: 800px;">
              <h1 class="section__title" style="margin: 0 0 16px;">Articles</h1>
            </div>
            
            <div style="margin-bottom: 32px;">
              <!-- Category Filter -->
              <div class="category-filter">
                {categories.map((cat) => (
                  <button 
                    class={`category-filter__btn ${cat === 'all' ? 'category-filter__btn--active' : ''}`}
                    data-category={cat}
                  >
                    {cat === 'all' ? 'All' : cat.toUpperCase()}
                  </button>
                ))}
              </div>
            </div>

            <div class="blog-grid" id="blog-grid">
              {posts.map((post) => (
                <BlogCard post={post} showCategory={true} compact={false} />
              ))}
            </div>
          </div>
        </section>
      </>
    ) : (
      <section class="section">
        <div class="container">
          <p class="text--muted" style="text-align: center; padding: 60px 0;">
            No articles yet. Check back soon for official publications from SPHERE.
          </p>
        </div>
      </section>
    )}
  </main>
</BaseLayout>

<style>
  .blog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media (min-width: 768px) {
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .blog-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .reports-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    margin-bottom: 60px;
  }
  @media (min-width: 768px) {
    .reports-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .report-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
  }
  .report-card__image {
    width: 100%;
    height: 300px;
    background: #f8fafc;
  }
  .report-card__image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }
  .report-card__content {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 32px;
  }
  @media (max-width: 767px) {
    .report-card__content {
      padding: 24px;
    }
  }
  .report-card__title {
    margin: 0 0 16px;
    font-size: 24px;
    line-height: 1.3;
  }
  .report-card__desc {
    opacity: 0.8;
    font-size: 15px;
    line-height: 1.6;
    margin-bottom: 16px;
  }
  .report-card__list {
    margin: 0 0 16px 20px;
    opacity: 0.8;
    font-size: 15px;
    line-height: 1.6;
  }
  .report-card__list li {
    margin-bottom: 8px;
  }

  .category-filter {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .category-filter__btn {
    padding: 8px 16px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .category-filter__btn:hover {
    border-color: var(--accent);
    background: rgba(2, 132, 199, 0.05);
    color: var(--accent);
  }

  .category-filter__btn--active {
    background: var(--accent);
    color: white;
    border-color: var(--accent);
  }
</style>

<script>
  // Read More functionality
  const readMoreBtns = document.querySelectorAll('.btn--read-more');
  if (readMoreBtns) {
    readMoreBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const moreContent = e.target.previousElementSibling;
        if (moreContent.style.display === 'none') {
          moreContent.style.display = 'block';
          e.target.textContent = 'Read Less';
        } else {
          moreContent.style.display = 'none';
          e.target.textContent = 'Read More';
        }
      });
    });
  }

  // Client-side category filtering
  const filterButtons = document.querySelectorAll('.category-filter__btn');
  const blogGrid = document.getElementById('blog-grid');
  
  if (filterButtons && blogGrid) {
    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const category = btn.dataset.category;
        
        // Update active state
        filterButtons.forEach(b => b.classList.remove('category-filter__btn--active'));
        btn.classList.add('category-filter__btn--active');
        
        // Filter posts
        const posts = blogGrid.querySelectorAll('.blog-card');
        posts.forEach((post: HTMLElement) => {
          if (category === 'all') {
            post.style.display = 'block';
          } else {
            const postCategory = post.querySelector('.blog-card__category')?.textContent?.trim().toLowerCase();
            post.style.display = postCategory === category ? 'block' : 'none';
          }
        });
      });
    });
  }
</script>
