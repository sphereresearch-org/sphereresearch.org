---
import "../styles/global.css";
import { ViewTransitions } from 'astro:transitions';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  lang?: string;
}
const {
  title = 'SPHERE — Human & Digital Rights',
  description = 'SPHERE: Human rights, digital rights, and community action in Sri Lanka.',
  image = '/og-default.png',
  type = 'website',
  noindex = false,
  lang = 'en',
} = Astro.props;

const activePath = Astro.url.pathname.split('/')[1] || 'home';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
const navLinks = [
  { id: 'home', href: '/', label: 'Home' },
  { id: 'about', href: '/about', label: 'About' },
  { id: 'cdpr', href: '/cdpr', label: 'CDPR' },
  { id: 'blog', href: '/blog', label: 'Blog' },
  { id: 'contact', href: '/contact', label: 'Contact' },
];
---
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Noto+Sans+Tamil:wght@400;500;600;700;800&family=Noto+Serif+Sinhala:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:site_name" content="SPHERE" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:alt" content={title} />
    {image === '/og-default.png' && <meta property="og:image:width" content="1200" />}
    {image === '/og-default.png' && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <title>{title}</title>
    <ViewTransitions />
  </head>
  <body>
    <header class="header">
      <div class="container header__wrap">
        <a class="brand" href="/" aria-label="SPHERE">
          <img class="brand__mark" src="/logo.png" alt="" aria-hidden="true" />
          <div>
            <span class="brand__name">SPHERE</span>
            <span class="brand__tag">Sphere Research and Advocacy</span>
          </div>
        </a>
        <div class="header__wrap-right">
          <nav class="nav" id="primary-nav" aria-label="Primary">
            {navLinks.map((link) => (
              <a class={`nav__link ${activePath === link.id || (link.id === 'home' && activePath === '') ? 'active' : ''}`} href={link.href}>{link.label}</a>
            ))}
          </nav>
          <button
            class="menu"
            id="nav-toggle"
            type="button"
            aria-label="Toggle menu"
            aria-expanded="false"
            aria-controls="primary-nav"
          >
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="4" y1="7" x2="20" y2="7" /><line x1="4" y1="12" x2="20" y2="12" /><line x1="4" y1="17" x2="20" y2="17" /></svg>
          </button>
        </div>
      </div>
    </header>
    <slot />
    <footer class="footer">
      <div class="container footer__grid">
        <div class="footer__brandtext">
          <strong>SPHERE</strong> — Society for the Progress, Human Rights,
          Empowerment & Equity<br />
          <span>
            © <span id="year">{new Date().getFullYear()}</span> SPHERE Research and Advocacy. All rights reserved.
          </span>
        </div>
      </div>
    </footer>
    <script is:inline>
      // Header and footer are swapped on every view transition, so listen on
      // the document once and look the elements up at event time.
      if (!window.__sphereNavReady) {
        window.__sphereNavReady = true;
        document.addEventListener("click", (event) => {
          const nav = document.getElementById("primary-nav");
          const toggle = document.getElementById("nav-toggle");
          if (!nav || !toggle) return;
          if (toggle.contains(event.target)) {
            nav.classList.toggle("is-open");
          } else if (!nav.contains(event.target) || event.target.closest(".nav__link")) {
            nav.classList.remove("is-open");
          }
          toggle.setAttribute("aria-expanded", String(nav.classList.contains("is-open")));
        });
        document.addEventListener("astro:page-load", () => {
          const year = document.getElementById("year");
          if (year) year.textContent = new Date().getFullYear();
        });
      }
    </script>
  </body>
</html>
